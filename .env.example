# Backend API URL
# Prefer using a relative path (/api) so production does NOT ship with localhost.
# For production (separate domains), set full URL like: https://api.yourdomain.com/api
# REACT_APP_API_URL=/api

# CRA proxy target (used by src/setupProxy.js)
# Dev-only: where your backend server runs locally
REACT_APP_PROXY_TARGET=http://localhost:5000

# Backend origin fallbacks probed when REACT_APP_PROXY_TARGET is unset (dev only)
# REACT_APP_BACKEND_ORIGIN=http://localhost:5000
# REACT_APP_BACKEND_PORT_START=5000
# REACT_APP_BACKEND_PORT_RANGE=25

# Socket.IO backend origin (used by NotificationContext)
# REACT_APP_SOCKET_URL=http://localhost:5000

# Razorpay Configuration (for frontend)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# Meta Pixel / Conversions API
# REACT_APP_META_PIXEL_ID=
# REACT_APP_META_CAPI_ENABLED=true

# GST / tax rate used at checkout (decimal, e.g. 0.18 = 18%)
# REACT_APP_TAX_RATE=0.18
