[TEMPLATE]
# Backend API URL
# Prefer using a relative path (/api) so production does NOT ship with localhost.
# For production (separate domains), set full URL like: https://api.yourdomain.com/api
# VITE_API_URL=/api

# Backend origin fallbacks probed when VITE_API_URL is unset (dev only)
# VITE_BACKEND_ORIGIN=http://localhost:8000
# VITE_BACKEND_PORT_START=8000
# VITE_BACKEND_PORT_RANGE=25

# Socket.IO backend origin (used by NotificationContext)
# VITE_SOCKET_URL=http://localhost:8000

# Brand name displayed in the UI
# VITE_BRAND_NAME=GlowAlchemy

# Razorpay Configuration (for frontend)
# Only the PUBLIC key ID is exposed to the browser. Never put the secret here.
# VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# Meta Pixel / Conversions API
# VITE_META_PIXEL_ID=
# VITE_META_CAPI_ENABLED=true

# GST / tax rate used at checkout (decimal, e.g. 0.18 = 18%)
# VITE_TAX_RATE=0.18
