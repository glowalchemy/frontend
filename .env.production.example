# GlowAlchemy Customer Frontend — PRODUCTION template.
# Copy to `.env` / `.env.production` at build time. Never commit real secrets.

# API base. Prefer same-origin "/api" behind a reverse proxy, or the full
# production API origin once the backend domain is confirmed.
# VITE_API_URL=/api
# VITE_API_URL=https://api.glowalchemycare.com/api

# Backend origin used to build absolute asset URLs (product/category images).
# Leave empty to use the page origin.
# VITE_BACKEND_ORIGIN=https://api.glowalchemycare.com

# Socket.IO backend origin (defaults to VITE_API_URL / same origin)
# VITE_SOCKET_URL=https://api.glowalchemycare.com

VITE_BRAND_NAME=GlowAlchemy

# Razorpay PUBLIC key id only — never the secret.
# VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX

# Meta Pixel (browser-side)
# VITE_META_PIXEL_ID=
# VITE_META_CAPI_ENABLED=true

# Tax rate used at checkout (decimal)
# VITE_TAX_RATE=0.18
