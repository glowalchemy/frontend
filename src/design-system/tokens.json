      "lineHeight": "1.5",
      "fontWeight": 400
    },
    "button": {
      "fontFamily": "$ref:typography.fontFamily.sans",
      "fontSize": "15px",
      "lineHeight": "1.2",
      "fontWeight": 500
    },
    "label": {
      "fontFamily": "$ref:typography.fontFamily.sans",
      "fontSize": "12px",
      "lineHeight": "1.3",
      "fontWeight": 600,
      "textTransform": "uppercase",
      "letterSpacing": "0.16em"
    },
    "navigation": {
      "fontFamily": "$ref:typography.fontFamily.sans",
      "fontSize": "15px",
      "lineHeight": "1.2",
      "fontWeight": 500
    },
    "price": {
      "fontFamily": "$ref:typography.fontFamily.sans",
      "fontSize": "17px",
      "lineHeight": "1.2",
      "fontWeight": 600
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "40px",
    "4xl": "48px",
    "5xl": "64px",
    "6xl": "80px"
  },
  "radius": {
    "none": "0px",
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "26px",
    "pill": "9999px",
    "circle": "50%"
  },
  "shadow": {
    "sm": "0 2px 8px rgba(111, 18, 48, 0.06)",
    "md": "0 10px 30px rgba(111, 18, 48, 0.10)",
    "lg": "0 24px 60px rgba(111, 18, 48, 0.16)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "zIndex": {
    "base": 1,
    "stories": 10,
    "dropdown": 100,
    "sticky": 200,
    "mobileNav": 400,
    "modalBackdrop": 500,
    "modal": 600,
    "popover": 700,
    "tooltip": 800,
    "toast": 900,
    "header": 1000,
    "mobileMenu": 1100
  },
  "transition": {
    "fast": "150ms ease-in-out",
    "base": "250ms ease-in-out",
    "slow": "350ms ease-in-out"
  },
  "component": {
    "button": {
      "primary": {
        "background": "$ref:color.semantic.action.primary",
        "text": "$ref:color.semantic.text.inverse",
        "hoverBackground": "$ref:color.semantic.action.primary-hover",
        "activeBackground": "$ref:color.semantic.action.primary-active",
        "radius": "$ref:radius.lg"
      },
      "secondary": {
        "background": "$ref:color.semantic.action.secondary",
        "text": "$ref:color.semantic.text.inverse",
        "radius": "$ref:radius.lg"
      },
      "accent": {
        "background": "$ref:color.semantic.action.accent",
        "text": "$ref:color.semantic.text.primary",
        "radius": "$ref:radius.pill"
      },
      "ghost": {
        "background": "transparent",
        "text": "$ref:color.semantic.text.primary",
        "border": "$ref:color.semantic.border.default",
        "radius": "$ref:radius.lg"
      },
      "danger": {
        "background": "$ref:color.semantic.status.error",
        "text": "$ref:color.semantic.text.inverse",
        "radius": "$ref:radius.lg"
      }
    },
    "input": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "focusBorder": "$ref:color.semantic.border.focus",
      "text": "$ref:color.semantic.text.primary",
      "radius": "$ref:radius.md"
    },
    "card": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.sm"
    },
    "header": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "text": "$ref:color.semantic.brand.primary",
      "zIndex": "$ref:zIndex.header"
    },
    "navigation": {
      "text": "$ref:color.semantic.text.primary",
      "active": "$ref:color.semantic.action.accent",
      "hoverBackground": "$ref:color.semantic.background.secondary"
    },
    "story": {
      "border": "$ref:color.semantic.border.default",
      "activeBorder": "$ref:color.semantic.action.accent",
      "radius": "$ref:radius.circle"
    },
    "productCard": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "title": "$ref:color.semantic.text.primary",
      "price": "$ref:color.semantic.text.primary",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.sm"
    },
    "footer": {
      "background": "$ref:color.semantic.brand.primary",
      "text": "$ref:color.semantic.text.inverse",
      "muted": "$ref:color.semantic.text.secondary",
      "accent": "$ref:color.semantic.action.accent"
    },
    "badge": {
      "background": "$ref:color.semantic.action.accent",
      "text": "$ref:color.semantic.text.primary",
      "radius": "$ref:radius.pill"
    },
    "modal": {
      "background": "$ref:color.semantic.background.surface",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.lg",
      "zIndex": "$ref:zIndex.modal"
    },
    "toast": {
      "background": "$ref:color.semantic.brand.primary",
      "text": "$ref:color.semantic.text.inverse",
      "zIndex": "$ref:zIndex.toast"
    }
  }
}