    "text-muted": { "$ref": "color.raw.muted" },
    "text-inverse": { "$ref": "color.raw.warm-white" },
    "border": { "$ref": "color.raw.border" },
    "focus": { "$ref": "color.raw.forest" },
    "success": { "$ref": "color.raw.success" },
    "warning": { "$ref": "color.raw.warning" },
    "error": { "$ref": "color.raw.error" }
