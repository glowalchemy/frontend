  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "40px",
    "4xl": "48px",
    "5xl": "64px",
    "6xl": "80px"
  },
  "radius": {
    "none": "0px",
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "26px",
    "pill": "9999px",
    "circle": "50%"
  },
  "shadow": {
    "sm": "0 2px 8px rgba(20, 61, 43, 0.06)",
    "md": "0 10px 30px rgba(20, 61, 43, 0.10)",
    "lg": "0 24px 60px rgba(20, 61, 43, 0.16)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "zIndex": {
    "base": 1,
    "stories": 10,
    "dropdown": 100,
    "sticky": 200,
    "mobileNav": 400,
    "modalBackdrop": 500,
    "modal": 600,
    "popover": 700,
    "tooltip": 800,
    "toast": 900,
    "header": 1000,
    "mobileMenu": 1100
  },
  "transition": {
    "fast": "150ms ease-in-out",
    "base": "250ms ease-in-out",
    "slow": "350ms ease-in-out"
  },
  "component": {
    "button": {
      "primary": {
        "background": "$ref:color.raw.forest",
        "text": "$ref:color.raw.warm-white",
        "hoverBackground": "$ref:color.raw.botanical",
        "activeBackground": "$ref:color.raw.forest-deepest",
        "radius": "$ref:radius.lg"
      },
      "secondary": {
        "background": "$ref:color.raw.ivory",
        "text": "$ref:color.raw.forest",
        "border": "$ref:color.raw.forest",
        "radius": "$ref:radius.lg"
      },
      "accent": {
        "background": "$ref:color.raw.gold",
        "text": "$ref:color.raw.brown",
        "radius": "$ref:radius.pill"
      },
      "ghost": {
        "background": "transparent",
        "text": "$ref:color.raw.brown",
        "border": "$ref:color.raw.border",
        "radius": "$ref:radius.lg"
      },
      "danger": {
        "background": "$ref:color.raw.error",
        "text": "$ref:color.raw.warm-white",
        "radius": "$ref:radius.lg"
      }
    },
    "input": {
      "background": "$ref:color.raw.warm-white",
