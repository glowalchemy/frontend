{
  "$comment": "GlowAlchemy Design Tokens — SINGLE SOURCE OF TRUTH for the entire UI. Raw color values live under color.raw; everything else references them via $ref or is derived. Edit this file and run `node src/design-system/generate.mjs` to regenerate src/styles/tokens.css. See src/design-system/README.md.",
  "meta": {
    "brand": "GlowAlchemy",
    "description": "Logo-derived design tokens: forest green + cream + gold. Natural, premium, botanical, elegant.",
    "version": "1.0.0"
  },

  "color": {
    "raw": {
      "deep-forest": "#213D31",
      "forest-green": "#315A46",
      "sage": "#6F8B63",
      "warm-gold": "#D4A94F",
      "soft-gold": "#E6C979",
      "cream": "#FBF9EC",
      "warm-ivory": "#F5F1DE",
      "charcoal": "#18231F",
      "white": "#FFFFFF"
    },
    "semantic": {
      "brand": {
        "primary": { "$ref": "color.raw.deep-forest" },
        "secondary": { "$ref": "color.raw.forest-green" },
        "sage": { "$ref": "color.raw.sage" },
        "gold": { "$ref": "color.raw.warm-gold" },
        "gold-soft": { "$ref": "color.raw.soft-gold" },
        "cream": { "$ref": "color.raw.cream" },
        "ivory": { "$ref": "color.raw.warm-ivory" },
        "ink": { "$ref": "color.raw.charcoal" },
        "white": { "$ref": "color.raw.white" }
      },
      "background": {
        "primary": { "$ref": "color.raw.cream" },
        "secondary": { "$ref": "color.raw.warm-ivory" },
        "surface": { "$ref": "color.raw.white" }
      },
      "text": {
        "primary": { "$ref": "color.raw.charcoal" },
        "secondary": "#52645A",
        "muted": "#7B857E",
        "inverse": { "$ref": "color.raw.white" }
      },
      "border": {
        "default": "#DDD8C4",
        "strong": "#C9C19F",
        "focus": { "$ref": "color.raw.warm-gold" }
      },
      "action": {
        "primary": { "$ref": "color.raw.deep-forest" },
        "primary-hover": { "$ref": "color.raw.forest-green" },
        "primary-active": "#2A4A3C",
        "secondary": { "$ref": "color.raw.forest-green" },
        "accent": { "$ref": "color.raw.warm-gold" },
        "accent-soft": { "$ref": "color.raw.soft-gold" }
      },
      "status": {
        "success": "#4F765D",
        "warning": { "$ref": "color.raw.warm-gold" },
        "error": "#B84C4C",
        "info": "#527A75"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": ["Roboto", "system-ui", "Arial", "sans-serif"],
      "serif": ["Rasa", "Georgia", "'Times New Roman'", "serif"]
    },
    "display": { "fontFamily": "$ref:typography.fontFamily.serif", "fontSize": "40px", "lineHeight": "1.1", "fontWeight": 700 },
    "h1": { "fontFamily": "$ref:typography.fontFamily.serif", "fontSize": "32px", "lineHeight": "1.2", "fontWeight": 700 },
    "h2": { "fontFamily": "$ref:typography.fontFamily.serif", "fontSize": "26px", "lineHeight": "1.25", "fontWeight": 700 },
    "h3": { "fontFamily": "$ref:typography.fontFamily.serif", "fontSize": "21px", "lineHeight": "1.3", "fontWeight": 600 },
    "h4": { "fontFamily": "$ref:typography.fontFamily.serif", "fontSize": "18px", "lineHeight": "1.35", "fontWeight": 600 },
    "body": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "15px", "lineHeight": "1.6", "fontWeight": 400 },
    "bodySmall": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "13px", "lineHeight": "1.5", "fontWeight": 400 },
    "caption": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "12px", "lineHeight": "1.4", "fontWeight": 400 },
    "button": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "14px", "lineHeight": "1.2", "fontWeight": 600 },
    "label": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "12px", "lineHeight": "1.3", "fontWeight": 600, "textTransform": "uppercase", "letterSpacing": "0.06em" },
    "navigation": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "14px", "lineHeight": "1.2", "fontWeight": 500 },
    "price": { "fontFamily": "$ref:typography.fontFamily.sans", "fontSize": "16px", "lineHeight": "1.2", "fontWeight": 700 }
  },

  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "40px",
    "4xl": "48px",
    "5xl": "64px",
    "6xl": "80px"
  },

  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "9999px",
    "circle": "50%"
  },

  "shadow": {
    "sm": "0 1px 3px rgba(33, 61, 49, 0.08)",
    "md": "0 4px 12px rgba(33, 61, 49, 0.10)",
    "lg": "0 10px 30px rgba(33, 61, 49, 0.12)"
  },

  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },

  "zIndex": {
    "base": 1,
    "stories": 10,
    "dropdown": 100,
    "sticky": 200,
    "mobileNav": 400,
    "modalBackdrop": 500,
    "modal": 600,
    "popover": 700,
    "tooltip": 800,
    "toast": 900,
    "header": 1000,
    "mobileMenu": 1100
  },

  "transition": {
    "fast": "150ms ease-in-out",
    "base": "250ms ease-in-out",
    "slow": "350ms ease-in-out"
  },

  "component": {
    "button": {
      "primary": { "background": "$ref:color.semantic.action.primary", "text": "$ref:color.semantic.text.inverse", "hoverBackground": "$ref:color.semantic.action.primary-hover", "activeBackground": "$ref:color.semantic.action.primary-active", "radius": "$ref:radius.lg" },
      "secondary": { "background": "$ref:color.semantic.action.secondary", "text": "$ref:color.semantic.text.inverse", "radius": "$ref:radius.lg" },
      "accent": { "background": "$ref:color.semantic.action.accent", "text": "$ref:color.semantic.text.primary", "radius": "$ref:radius.pill" },
      "ghost": { "background": "transparent", "text": "$ref:color.semantic.text.primary", "border": "$ref:color.semantic.border.default", "radius": "$ref:radius.lg" },
      "danger": { "background": "$ref:color.semantic.status.error", "text": "$ref:color.semantic.text.inverse", "radius": "$ref:radius.lg" }
    },
    "input": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "focusBorder": "$ref:color.semantic.border.focus",
      "text": "$ref:color.semantic.text.primary",
      "radius": "$ref:radius.md"
    },
    "card": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.sm"
    },
    "header": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "text": "$ref:color.semantic.brand.primary",
      "zIndex": "$ref:zIndex.header"
    },
    "navigation": {
      "text": "$ref:color.semantic.text.primary",
      "active": "$ref:color.semantic.action.accent",
      "hoverBackground": "$ref:color.semantic.background.secondary"
    },
    "story": {
      "border": "$ref:color.semantic.border.default",
      "activeBorder": "$ref:color.semantic.action.accent",
      "radius": "$ref:radius.circle"
    },
    "productCard": {
      "background": "$ref:color.semantic.background.surface",
      "border": "$ref:color.semantic.border.default",
      "title": "$ref:color.semantic.text.primary",
      "price": "$ref:color.semantic.text.primary",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.sm"
    },
    "footer": {
      "background": "$ref:color.semantic.brand.primary",
      "text": "$ref:color.semantic.text.inverse",
      "muted": "$ref:color.semantic.text.secondary",
      "accent": "$ref:color.semantic.action.accent"
    },
    "badge": {
      "background": "$ref:color.semantic.action.accent",
      "text": "$ref:color.semantic.text.primary",
      "radius": "$ref:radius.pill"
    },
    "modal": {
      "background": "$ref:color.semantic.background.surface",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.lg",
      "zIndex": "$ref:zIndex.modal"
    },
    "toast": {
      "background": "$ref:color.semantic.brand.primary",
      "text": "$ref:color.semantic.text.inverse",
      "zIndex": "$ref:zIndex.toast"
    }
  }
}
