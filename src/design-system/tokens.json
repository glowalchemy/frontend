      "focusBorder": "$ref:color.raw.forest",
      "text": "$ref:color.raw.brown",
      "radius": "$ref:radius.md"
    },
    "card": {
      "background": "$ref:color.raw.warm-white",
      "border": "$ref:color.raw.border",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.sm"
    },
    "header": {
      "background": "$ref:color.raw.forest",
      "border": "$ref:color.raw.forest-deepest",
      "text": "$ref:color.raw.ivory",
      "zIndex": "$ref:zIndex.header"
    },
    "navigation": {
      "text": "$ref:color.raw.warm-white",
      "active": "$ref:color.raw.gold",
      "hoverBackground": "$ref:color.raw.botanical"
    },
    "story": {
      "border": "$ref:color.raw.border",
      "activeBorder": "$ref:color.raw.gold",
      "radius": "$ref:radius.circle"
    },
    "productCard": {
      "background": "$ref:color.raw.warm-white",
      "border": "$ref:color.raw.border",
      "title": "$ref:color.raw.brown",
      "price": "$ref:color.raw.brown",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.sm"
    },
    "footer": {
      "background": "$ref:color.raw.forest-deepest",
      "text": "$ref:color.raw.ivory",
      "muted": "$ref:color.raw.champagne",
      "accent": "$ref:color.raw.gold"
    },
    "badge": {
      "background": "$ref:color.raw.gold",
      "text": "$ref:color.raw.brown",
      "radius": "$ref:radius.pill"
    },
    "modal": {
      "background": "$ref:color.raw.warm-white",
      "radius": "$ref:radius.lg",
      "shadow": "$ref:shadow.lg",
      "zIndex": "$ref:zIndex.modal"
    },
    "toast": {
      "background": "$ref:color.raw.forest",
      "text": "$ref:color.raw.warm-white",
      "zIndex": "$ref:zIndex.toast"
    }
  }
