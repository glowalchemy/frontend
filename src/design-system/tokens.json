    "primary": { "$ref": "color.raw.forest" },
    "primary-hover": { "$ref": "color.raw.botanical" },
    "primary-active": { "$ref": "color.raw.forest-deepest" },
    "secondary": { "$ref": "color.raw.botanical" },
    "accent": { "$ref": "color.raw.gold" },
    "background": { "$ref": "color.raw.ivory" },
    "surface": { "$ref": "color.raw.warm-white" },
    "surface-muted": { "$ref": "color.raw.sage-light" },
