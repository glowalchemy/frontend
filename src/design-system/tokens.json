    "h4": {
      "fontFamily": "$ref:typography.fontFamily.serif",
      "fontSize": "20px",
      "lineHeight": "1.35",
      "fontWeight": 600
    },
    "body": {
      "fontFamily": "$ref:typography.fontFamily.sans",
      "fontSize": "16px",
      "lineHeight": "1.7",
      "fontWeight": 400
    },
    "bodySmall": {
      "fontFamily": "$ref:typography.fontFamily.sans",
      "fontSize": "14px",
      "lineHeight": "1.6",
      "fontWeight": 400
