{
  "$comment": "GlowAlchemy Design Tokens — SINGLE SOURCE OF TRUTH for the entire UI. Raw color values live under color.raw; everything else references them via $ref or is derived. Edit this file and run `node src/design-system/generate.mjs` to regenerate src/styles/tokens.css. See src/design-system/README.md.",
  "meta": {
    "brand": "GlowAlchemy",
    "description": "Premium burgundy + blush beauty palette. Elegant serif headings, clean sans body.",
    "version": "2.0.0"
  },
  "color": {
    "raw": {
      "deep-burgundy": "#6F1230",
      "burgundy": "#851638",
      "rose": "#B85C7A",
      "blush": "#EFC3D2",
      "blush-light": "#FCEAF0",
      "cream": "#FFF9F5",
      "light-pink": "#FFF4F7",
      "charcoal": "#29151F",
      "white": "#FFFFFF"
    },
    "semantic": {
      "brand": {
        "primary": {
          "$ref": "color.raw.deep-burgundy"
        },
        "secondary": {
          "$ref": "color.raw.burgundy"
        },
        "sage": {
          "$ref": "color.raw.rose"
        },
        "gold": {
          "$ref": "color.raw.blush"
        },
        "gold-soft": {
          "$ref": "color.raw.blush-light"
        },
        "cream": {
          "$ref": "color.raw.cream"
        },
        "ivory": {
          "$ref": "color.raw.light-pink"
        },
        "ink": {
          "$ref": "color.raw.charcoal"
        },
        "white": {
          "$ref": "color.raw.white"
        }
      },
      "background": {
        "primary": {
          "$ref": "color.raw.cream"
        },
        "secondary": {
          "$ref": "color.raw.blush-light"
        },
        "surface": {
          "$ref": "color.raw.white"
        }
      },
      "text": {
        "primary": {
          "$ref": "color.raw.charcoal"
        },
        "secondary": "#6E4E5A",
        "muted": "#9A7C88",
        "inverse": {
          "$ref": "color.raw.white"
        }
      },
      "border": {
        "default": "#F3DDE5",
        "strong": "#E6C3D0",
        "focus": {
          "$ref": "color.raw.burgundy"
        }
      },
      "action": {
        "primary": {
          "$ref": "color.raw.burgundy"
        },
        "primary-hover": {
          "$ref": "color.raw.deep-burgundy"
        },
        "primary-active": "#5A0E26",
        "secondary": {
          "$ref": "color.raw.deep-burgundy"
        },
        "accent": {
          "$ref": "color.raw.blush"
        },
        "accent-soft": {
          "$ref": "color.raw.blush-light"
        }
      },
      "status": {
        "success": "#3F7A5A",
        "warning": "#C9973F",
        "error": "#B84C4C",
        "info": {
          "$ref": "color.raw.burgundy"
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": [
        "Jost",
        "system-ui",
        "Arial",
        "sans-serif"
      ],
      "serif": [
        "Playfair Display",
        "Georgia",
        "Times New Roman",
        "serif"
      ]
    },
    "display": {
      "fontFamily": "$ref:typography.fontFamily.serif",
      "fontSize": "58px",
      "lineHeight": "1.08",
      "fontWeight": 600,
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "fontFamily": "$ref:typography.fontFamily.serif",
      "fontSize": "44px",
      "lineHeight": "1.15",
      "fontWeight": 600
    },
    "h2": {
      "fontFamily": "$ref:typography.fontFamily.serif",
      "fontSize": "36px",
      "lineHeight": "1.2",
      "fontWeight": 600
