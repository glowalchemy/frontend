      "forest": "#143D2B",
      "botanical": "#24543A",
      "sage": "#75816B",
      "sage-light": "#E7EADD",
      "gold": "#B59A58",
      "champagne": "#D8C3A5",
      "champagne-soft": "#EADFCB",
      "ivory": "#F5EFE6",
      "warm-white": "#FFFCF7",
      "brown": "#302923",
      "brown-soft": "#4F483E",
      "muted": "#625C52",
      "border": "#DDD5C8",
      "border-strong": "#C9BFB0",
      "white": "#FFFFFF",
      "error": "#B42318",
      "success": "#216E46",
      "warning": "#7C5E18",
      "forest-50": "#F0F5F1",
      "forest-100": "#DCE7DF",
      "forest-200": "#B9CFC2",
      "forest-300": "#90B09E",
